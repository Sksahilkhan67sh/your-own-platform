# Copy to .env and fill in real values. NEVER commit the real .env file.

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/your-own?retryWrites=true&w=majority

# ---- CORS ----
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-own.vercel.app

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# ---- Cookies ----
# Optional. Leave blank in almost all cases — the cookie will then scope to
# the exact API host, which is correct for a single-host deployment. Only
# set this if you need the refresh cookie shared across multiple subdomains
# of the same registrable domain (e.g. api.your-own.com and
# admin.your-own.com both need to read it), in which case set it to the
# shared parent domain, e.g. your-own.com.
REFRESH_COOKIE_DOMAIN=

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12

# ---- AWS S3 (or S3-compatible: Cloudflare R2, etc.) ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
S3_BUCKET_NAME=your-own-land-images
S3_PUBLIC_BASE_URL=https://your-own-land-images.s3.ap-south-1.amazonaws.com
# Only needed for R2 / non-AWS S3-compatible endpoints. Leave blank for real AWS S3.
S3_ENDPOINT=

# ---- Seed script (admin bootstrap) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@your-own.com
SEED_ADMIN_PASSWORD=ChangeMe_StrongPassword123!

# ---- Rate limiting ----
LOGIN_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MIN=15


RESEND_API_KEY=<paste your new key here, in the file only>
EMAIL_FROM=onboarding@resend.dev
